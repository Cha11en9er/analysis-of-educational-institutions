                <script>

                    var charts = [];
                    let filter = '';
                    function filter_diagrams(){
                        if(charts[0]) {
                            chart = charts[0];
                            var ci = chart;

                            ci.data.datasets.forEach(function (e, i) {
                                var meta = ci.getDatasetMeta(i);

                                if (!meta.hidden) {
                                    //console.log(ci.getDatasetMeta(i)._dataset.label);
                                    filter += ci.getDatasetMeta(i)._dataset.label + '~';
                                }
                            });
                            return filter;
                        }
                        else
                            return "1.1.1~1.1.2~1.1.3~1.1.4~1.1.5~1.1.6~1.1.7~1.1.8~1.1.9~1.1.10~1.1.11~1.1.12~1.1.13~1.1.14~1.1.15~1.1.16~1.1.17~1.2.1~1.2.2~1.2.3~1.2.4~1.2.5~1.2.6~1.2.7~1.2.8";
                    }

                    // Функция для загрузки данных с AJAX
                    function fetchDataAndCreateChart(type_chart, i, chet) {
                        $.ajax({
                            url: '/reports_rgi/ajax_chart.php',
                            method: 'GET',
                            data: 'proc=get_data&type_chart=' + type_chart + '' +
                                '&get_data_type=oo'
                                + '&get_data_year=2025'
                                + '&get_data_select=243055'
                                + '&filter=' + filter_diagrams()
                                + '&get_data_step=20'
                                + '&get_data_offset=' + chet,
                            success: function (response) {
                                if (response != 'error') {
                                    createChart(response, '#stackedBarChart' + chet,"bar");
                                } else
                                    create_toasts('warning', 'Ошибка работы с данными, попробуйте перейти на эту страницу ещё раз');
                            },
                            error: function (error) {
                                console.error('Ошибка работы с данными:', error);
                            }
                        });
                    }

                    var chart = null;

                    function createChart(chartData, obj_name,type_diagram='bar') {

                        var ctx = $(obj_name).get(0).getContext('2d');
                        chart = new Chart(ctx, {
                            type: type_diagram,
                            data: chartData,
                            options: {
                                onClick: function(e,data, context) {
                                    // console.log(context)
                                    const activeElement = data[0];
                                    // console.log('activeElement',activeElement);
                                    if (activeElement) {
                                        let code_oo = context.data.labels[activeElement.index];
                                        if(code_oo==='Сар.обл')
                                            window.location.href = '/reports_rgi/?year=2025&all';
                                        else
                                        if((code_oo.toString().substr(3,3))==='000')
                                            window.location.href = '/reports_rgi/?year=2025&mup='+(code_oo.toString().substr(0,3))+ '&filter='+filter_diagrams();
                                        else
                                            window.location.href = '/reports_rgi/?year=2025&oo='+code_oo+ '&filter='+filter_diagrams();
                                    }
                                },
                                tooltips: {
                                    callbacks: {
                                        label: function (tooltipItem, data) {
                                            // console.log(tooltipItem, data)
                                            if (tooltipItem.datasetIndex === 0) {
                                                return 'Label: ' + data.datasets[tooltipItem.datasetIndex].label + ' Value: ' + data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                                            }
                                        }
                                    }
                                },
                                responsive: true,
                                maintainAspectRatio: false,
                                interaction: {
                                    intersect: false, // Отключение стандартного тултипа взаимодействия
                                },

                                plugins: {
                                    legend: {
                                        position: 'top',
                                        labels: {
                                            fontColor: 'rgb(255, 99, 132)'
                                        },
                                        onClick: function(e, legendItem) {
                                            change_filter(legendItem);
                                        },
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function (context) {
                                                // console.log(context.label)
                                                // console.log(chartData.code_oo)
                                                var opisanie = chartData.tooltips[context.dataset.label];
                                                var label = context.dataset.label + ' = ' + context.raw + '%' || '';
                                                label+= ' '+ chartData.code_oo[context.label];
                                                return label;
                                            },
                                            footer: function (tooltipItems, context) {
                                                return '\n' + chartData.tooltips[tooltipItems[0].dataset.label];
                                            },
                                        }
                                    }
                                },
                                indexAxis: 'y',
                                scales: {
                                    x: {
                                        beginAtZero: true,
                                        stacked: true,
                                        min: 0,
                                        max: 1200,
                                    },
                                    y: {
                                        beginAtZero: true,
                                        stacked: true
                                    },
                                },
                                sorted:false,
                            }
                        });

                        charts.push(chart);

                        var sort_filter = "1.1.1~1.1.2~1.1.3~1.1.4~1.1.5~1.1.6~1.1.7~1.1.8~1.1.9~1.1.10~1.1.11~1.1.12~1.1.13~1.1.14~1.1.15~1.1.16~1.1.17~1.2.1~1.2.2~1.2.3~1.2.4~1.2.5~1.2.6~1.2.7~1.2.8";
                        if(sort_filter.trim()!='') {
                            var filtred = sort_filter.split('~');
                            if (filtred.length > 0) {
                                chart.data.datasets.forEach(function (e, i) {
                                    var meta = chart.getDatasetMeta(i);
                                    if (!filtred.includes(meta._dataset.label))
                                        meta.hidden = meta.hidden === null ? !meta.hidden : null;
                                });

                                chart.update();
                            }
                        }
                    }

                    // function  change_filter_sidebar(legendItem_sidebar){
                    //     charts.forEach(chart => {
                    //         var ci = chart;
                    //
                    //         ci.data.datasets.forEach(function (e, i) {
                    //             var meta = ci.getDatasetMeta(i);
                    //
                    //             if (i._dataset.label == legendItem_sidebar) {
                    //                 meta.hidden = meta.hidden === null ? !meta.hidden : null;
                    //             }
                    //         });
                    //
                    //         ci.update();
                    //     })
                    // }

                    function  change_filter(legendItem){
                        charts.forEach(chart => {
                            var index = legendItem.datasetIndex;
                            var ci = chart;

                            ci.data.datasets.forEach(function (e, i) {
                                var meta = ci.getDatasetMeta(i);

                                if (i == index) {
                                    meta.hidden = meta.hidden === null ? !meta.hidden : null;
                                }
                            });

                            ci.update();
                        })
                    }

                    $(function () {
                        const inversions = document.querySelectorAll('.inversion');
                        inversions.forEach(inversion => {
                            inversion.addEventListener('click', function() {
                                charts.forEach(chart => {
                                    var ci = chart;

                                    ci.data.datasets.forEach(function(e, i) {
                                        var meta = ci.getDatasetMeta(i);

                                        meta.hidden = meta.hidden === null ? !meta.hidden : null;
                                    });

                                    ci.update();
                                });
                            });
                        });

                    });


                    function filter_diagrams_click(){
                        var searchParams = new URLSearchParams(window.location.search);
                        let newUrl = '/reports_rgi/?';
                        searchParams.forEach((value, key) => {
                            // console.log('Key: ' + key + ', Value: ' + value);
                            if(key!='filter') newUrl += '&'+key + (value!=''?'=' + value:'');
                        });
                        newUrl += '&filter='+filter_diagrams();
                        // console.log(newUrl)
                        window.location.href = newUrl;
                    }

                </script>

