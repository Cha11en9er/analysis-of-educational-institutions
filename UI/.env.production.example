# Скопировать в UI/.env.production перед npm run build на сервере
# (или в UI/.env — CRA подхватит)

# Пусто = запросы на тот же домен (/api/...), nginx проксирует на uvicorn
REACT_APP_API_URL=

# Ключ JavaScript API Яндекс.Карт (кабинет developer.tech.yandex.ru)
# В ограничениях Referrer укажите: https://uchgrad.ru/* и https://www.uchgrad.ru/*
REACT_APP_YANDEX_MAPS_API_KEY=
